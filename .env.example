# Copy to .env for local development. Never commit the filled-in file.
# In production these live in the Vercel project's environment variables.

# Supabase Postgres connection string
DATABASE_URL=

# Mailchimp Marketing API.
# API key: profile picture > Profile > Extras > API keys > Create A Key.
# The part after the dash in the key (e.g. us21) is the server prefix.
# Audience ID: Audience > More options > Audience settings.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Guards GET /api/leads and PATCH /api/leads/:id, and is what the /developer
# dashboard asks for. Without it those endpoints refuse every request.
# Use something long and random, not a five-digit number.
ADMIN_PASSCODE=
